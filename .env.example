# ==============================================================================
# AI Hospital Receptionist & Appointment Booking Voice Agent - Environment Config
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Configuration
# Local SQLite fallback is automatically used if PostgreSQL is not running or if set to sqlite:
# DATABASE_URL=sqlite+aiosqlite:///./hospital.db
DATABASE_URL=postgresql+asyncpg://hospital_user:hospital_password@localhost:5432/hospital_voice_db
DATABASE_ECHO=false

# Cache / Redis Configuration (Optional: in-memory cache is used as fallback)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# LLM Provider Configuration
# Supported options: "mock", "gemini", "openai", "groq"
# In "mock" mode, zero paid keys are needed - a built-in intelligent rule & dialogue engine handles real appointment flows!
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2

# Sarvam AI STT & TTS Configuration
# When SARVAM_API_KEY is empty, high-fidelity mock audio & browser speech synthesis/recognition fallback are used.
SARVAM_API_KEY=
SARVAM_STT_LANGUAGE_CODE=en-IN
# Sarvam Bulbul TTS Voice Models (e.g. bulbul:v1, bulbul:v2)
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_TTS_SPEAKER=ananya

# Telephony - Plivo (Optional)
# In development, telephony is completely bypassed and local WebRTC / Web Audio WebSocket runs in the browser.
PLIVO_ENABLED=false
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
PLIVO_APP_URL=https://your-public-domain.ngrok-free.app

# Hospital Organization Details
HOSPITAL_NAME="Apex Multi-Specialty Hospital"
HOSPITAL_PHONE="+1-800-555-0199"
HOSPITAL_ADDRESS="742 Evergreen Healthcare Blvd, Medical District"
HOSPITAL_EMERGENCY_PHONE="911"
HOSPITAL_VISITING_HOURS="General Wards: 4:00 PM - 7:00 PM Daily | ICU: 11:00 AM - 12:00 PM"
